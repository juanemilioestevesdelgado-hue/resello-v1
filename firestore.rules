rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read their OWN document - no circular dependency
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // No one can write via client (only Admin SDK via server)
      allow write: if false;
    }

    // Attendance collection
    match /attendance/{docId} {
      // Anyone authenticated can read (admin checks done in UI)
      allow read: if request.auth != null;

      // Authenticated users can only create their OWN record
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Updates (flag/approve) allowed to any authenticated user
      // (real admin check is done server-side via Admin SDK)
      allow update: if request.auth != null;

      // No deletions from client
      allow delete: if false;
    }

    // QR Tokens - only accessible via Admin SDK (server)
    match /qr_tokens/{tokenId} {
      allow read, write: if false;
    }
  }
}
